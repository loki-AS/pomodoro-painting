# Copy to .env.local (git-ignored) and fill in to enable the spoken painting stories.
# The key is read by the dev server only and is never sent to the browser.
OPENAI_API_KEY=
# Optional: which OpenAI model writes the stories (default: gpt-5.5)
# OPENAI_MODEL=gpt-5.5

# Optional: Kokoro narrator voice from Hugging Face, runs in the browser (default: af_bella)
# e.g. af_heart, af_bella, bf_emma, am_michael, bm_george
# NARRATION_VOICE=af_bella
